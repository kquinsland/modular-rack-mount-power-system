	(text "SWD J10 (TC2030): 1 VTref, 2 SWDIO, 3 nRESET, 4 SWCLK, 5 GND, 6 NC. PA6/PA7 carry I2C2 SDA/SCL; PA15 is the DS18B20 1-Wire bus; PA1 drives the status NeoPixel. Fan 1 uses PA2/PA8; Fan 2 uses PA0/PB8."
		(exclude_from_sim no)
		(at 20 27.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "5ae37fe6-e915-47d9-a62b-4d2f3fe7b2e4")
	)
	(text "STM32C092GCU6 LOCAL CONTROL"
		(exclude_from_sim no)
		(at 20 17.5 0)
		(effects
