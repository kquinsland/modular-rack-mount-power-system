		)
		(uuid "88420e47-2e9e-4ec8-a511-0c58f4030de7")
	)
	(text "Hardware pin allocation only; firmware will be rewritten after the second-generation hardware stabilizes. I2C is local to U1 and INA237 only. PB0/PB1 use the carrier's FDCAN mapping."
		(exclude_from_sim no)
		(at 20 22.5 0)
