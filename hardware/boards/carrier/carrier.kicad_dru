(version 1)

# Ported from backplane-prototype for the same JLCPCB process.
# The conservative annular-ring rule is retained for the selected 1 oz outer copper.

# MOD1 is mounted above the carrier PCB. KiCad's courtyard DRC is two-dimensional,
# so it cannot verify the physical Z clearance. Only footprints deliberately assigned
# to the Under_PD_Module component class in the project settings may overlap MOD1's
# courtyard. Their assembled height above the carrier PCB, including tolerances, must
# not exceed 2.75 mm.

(rule "Allow qualified low-profile parts below MOD1"
    (condition "(A.Reference == 'MOD1' && B.hasComponentClass('Under_PD_Module')) || (B.Reference == 'MOD1' && A.hasComponentClass('Under_PD_Module'))")
    (constraint courtyard_clearance (min -1mm)))

# J1, D2, and H9 are intentionally placed at the board interface. Keep these
# exceptions reference-specific so other connector, TVS, and tooling-hole
# courtyard conflicts remain visible.
(rule "Allow intentional J1 D2 courtyard overlap"
    (condition "(A.Reference == 'J1' && B.Reference == 'D2') || (A.Reference == 'D2' && B.Reference == 'J1')")
    (constraint courtyard_clearance (min -1mm)))

(rule "Allow intentional J1 H9 courtyard overlap"
    (condition "(A.Reference == 'J1' && B.Reference == 'H9') || (A.Reference == 'H9' && B.Reference == 'J1')")
    (constraint courtyard_clearance (min -1mm)))

# JLCPCB supports through vias for this process, not blind, buried, or microvias.
(rule "JLCPCB through vias only"
    (condition "A.Type == 'Via' && A.Via_Type != 'Through'")
    (constraint disallow via))

# Retain a conservative 0.255 mm PTH annular-ring minimum for fabrication.
(rule "JLCPCB conservative PTH fabrication"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint annular_width (min 0.255mm))
    (constraint hole_clearance (min 0.3mm)))

(rule "JLCPCB pad hole to hole clearance"
    (condition "A.Type == 'Pad' && B.Type == 'Pad'")
    (constraint hole_to_hole (min 0.45mm)))

(rule "JLCPCB minimum round NPTH"
    (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X == A.Hole_Size_Y")
    (constraint hole_size (min 0.5mm)))

(rule "JLCPCB minimum plated slot"
    (condition "A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 0.4mm)))

(rule "JLCPCB minimum non-plated slot"
    (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 1.0mm)))

(rule "JLCPCB legend text"
    (condition "(A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen') && (A.Type == 'Text' || A.Type == 'Text Box')")
    (constraint text_height (min 1.0mm))
    (constraint text_thickness (min 0.15mm)))

(rule "JLCPCB legend graphic line width"
    (condition "A.Type == 'Graphic' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen') && A.Line_Width > 0mm")
    (constraint assertion "A.Line_Width >= 0.15mm"))

# CANH is the P member and CANL is the N member on both sides of L3.
# The P/N suffixes enable KiCad's differential-pair router; these constraints
# provide the interactive gap target and enforce coupling and pair skew in DRC.
(rule "CAN differential pair coupling and skew"
    (condition "A.hasNetclass('CAN')")
    (constraint diff_pair_gap (min 0.20mm) (opt 0.25mm) (max 0.30mm))
    (constraint diff_pair_uncoupled (max 5mm))
    (constraint skew (max 1mm) (within_diff_pairs)))
