	(text "ASSEMBLY / FOOTPRINT CHECKS\nL1: Sunlord SWPA8040S680MT / C36418; footprint Inductor_SMD:L_Sunlord_SWPA8040S.\nC8: current footprint is 1206, but intended C602037 / CL21A226MAYNNNE is 0805.\nConfirm package and make footprint/MPN consistent across carrier and backpack before fabrication.\nVerify U2 package pin numbering and exposed-pad requirements against manufacturer drawings."
		(exclude_from_sim no)
		(at 292.1 151 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "191dbcb7-d5d5-4481-80ee-69eeb2ec206f")
	)
	(text "LM5163 Type-3 ripple injection; nominal 3.3 V / ~300 kHz. Keep SW/BST/ripple loop compact during PCB layout."
		(exclude_from_sim no)
		(at 20.32 99.06 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left bottom)
		)
		(uuid "365943f5-90b5-4f64-84c4-da6710c6ab21")
	)
	(text "RELEASE BLOCKER - CONNECTOR POLARITY\nCurrent carrier assumption: J1 pin 1 = VCC, pin 2 = GND, pin 3 = SMBus SDA, pin 4 = SMBus SCL.\nBackplane-prototype presently shows the power pins oppositely. Confirm physical mated contacts and drawing viewpoints,\nthen make symbol pins, footprint pads, net assignments, and notes consistent in every carrier/backplane project before fabrication."
		(exclude_from_sim no)
		(at 292.1 18 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5c608385-3f45-4bf9-9c37-b37415e5178a")
	)
