+#!/usr/bin/env python3
+"""Compare the opt-in Deku trial against manual codecs; run from any directory.
+
+Writes machine-readable measurements under target/deku-bench/results.json.
+Corpus and host benchmark executables use separate target directories. Never flashes hardware.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import tomllib
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "target/deku-bench"
+TARGET = "thumbv6m-none-eabi"
+TOOLCHAIN = tomllib.loads((ROOT / "rust-toolchain.toml").read_text())["toolchain"]["channel"]
+
+
+def run(args, *, env=None):
+    if args[0] in {"cargo", "rustc"}:
+        args = [args[0], f"+{TOOLCHAIN}", *args[1:]]
+    print("+ " + " ".join(map(str, args)), flush=True)
+    return subprocess.run(args, cwd=ROOT, env=env, text=True, stdout=subprocess.PIPE, check=True).stdout
+
+
+def size(path, llvm_size):
+    fields = run([str(llvm_size), str(path)]).splitlines()[-1].split()
+    text, data, bss = map(int, fields[:3])
+    return {"text": text, "data": data, "bss": bss, "flash": text + data, "static_ram": data + bss}
+
+
+def main():
+    OUT.mkdir(parents=True, exist_ok=True)
+    rustc = run(["rustc", "-vV"])
+    host = next(line.removeprefix("host: ") for line in rustc.splitlines() if line.startswith("host: "))
+    sysroot = run(["rustc", "--print", "sysroot"]).strip()
+    llvm_size = Path(sysroot) / "lib/rustlib" / host / "bin/llvm-size"
+    results = {"rustc": rustc, "platform": platform.platform(), "processor": platform.processor(),
+               "base_commit": "9680cd3992865a311ab963fa6192fc00b31434e8",
+               "benchmark": {"batches": 21, "iterations_per_batch": 100000, "warmup_iterations": 100000,
+                             "process_runs": 3, "inputs": 256, "profile": "Cargo default bench/release"}, "variants": {}}
+    executables = {}
+    corpora = {}
+    for variant in ["manual", "deku"]:
+        features = ["--features", "pdcan-protocol/deku-codec"] if variant == "deku" else []
+        target_dir = OUT / variant
+        common = ["--target-dir", str(target_dir)]
+        run(["cargo", "test", "--locked", "-p", "pdcan-protocol", *features, *common])
+        build = run(["cargo", "bench", "--locked", "-p", "pdcan-protocol", "--bench", "codec", "--no-run",
+                     "--message-format=json", *features, *common])
+        artifacts = [json.loads(line) for line in build.splitlines() if line.startswith("{")]
+        executable = next(a["executable"] for a in artifacts if a.get("executable") and a.get("target", {}).get("name") == "codec")
+        executables[variant] = executable
+        corpus = run([executable], env={**os.environ, "PDCAN_CORPUS": "1"})
+        corpora[variant] = corpus
+        measurements = {"corpus_sha256": hashlib.sha256(corpus.encode()).hexdigest(),
+                        "corpus_lines": len(corpus.splitlines()), "sizes": {}, "host_runs": []}
+        for package, binary, firmware_feature in [
+            ("backplane-firmware", "backplane", True),
+            ("carrier-firmware", "carrier", True),
+            ("pdcan-bootloader", "pdcan-bootloader", False),
+        ]:
+            # Selecting protocol explicitly also allows enabling its feature for the bootloader control build.
+            args = ["cargo", "build", "--locked", "--release", "--target", TARGET, "-p", package,
+                    "-p", "pdcan-protocol", "--bin", binary, *features, *common]
+            if firmware_feature:
+                args += ["--features", f"{package}/firmware-bin"]
+            run(args)
+            measurements["sizes"][binary] = size(target_dir / TARGET / "release" / binary, llvm_size)
+        run(["cargo", "build", "--locked", "--release", "--target", TARGET, "-p", "carrier-firmware",
+             "--example", "codec-size", "--features", "firmware-bin", *features, *common])
+        probe = target_dir / TARGET / "release/examples/codec-size"
+        measurements["sizes"]["codec-size"] = size(probe, llvm_size)
+        run(["cargo", "build", "--locked", "--release", "--target", TARGET, "-p", "carrier-firmware",
+             "--example", "codec-size", "--features", "firmware-bin", *features, *common,
+             "--config", 'profile.release.opt-level="z"', "--config", "profile.release.lto=true",
+             "--config", "profile.release.codegen-units=1"])
+        measurements["sizes"]["codec-size-lto-z"] = size(probe, llvm_size)
+        # A linked image with no allocator plus this feature tree establishes the no-alloc configuration.
+        measurements["deku_features"] = run(["cargo", "tree", "--locked", "-p", "pdcan-protocol", "-e", "features", *features])
+        results["variants"][variant] = measurements
+    if corpora["manual"] != corpora["deku"]:
+        for variant, corpus in corpora.items():
+            (OUT / f"{variant}-corpus.txt").write_text(corpus)
+        raise RuntimeError("Differential corpus mismatch; inspect saved corpora")
+    results["corpus_identical"] = True
+    # Alternate process order to reduce systematic warmup/load bias.
+    for repetition in range(3):
+        for variant in (["manual", "deku"] if repetition % 2 == 0 else ["deku", "manual"]):
+            output = run([executables[variant]])
+            sample = {}
+            for line in output.splitlines()[1:]:
+                operation, median, minimum, maximum = line.split(",")
+                sample[operation] = {"median_ns": float(median), "min_ns": float(minimum), "max_ns": float(maximum)}
+            results["variants"][variant]["host_runs"].append(sample)
+    for values in results["variants"].values():
+        values["host_median_ns"] = {
+            operation: statistics.median(run[operation]["median_ns"] for run in values["host_runs"])
+            for operation in values["host_runs"][0]
+        }
+    path = OUT / "results.json"
+    path.write_text(json.dumps(results, indent=2) + "\n")
+    print(f"Exact corpus comparison passed. Results: {path}")
+
+
+if __name__ == "__main__":
+    main()
