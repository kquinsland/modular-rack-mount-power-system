@@ -0,0 +1,47 @@
+//! Link-only size probe. This is not an application image for flashing.
+#![no_std]
+#![no_main]
+
+use core::hint::black_box;
+use cortex_m_rt::entry;
+use embassy_stm32 as _;
+use panic_halt as _;
+use pdcan_protocol::{
+    ControlCommand, ControlRequest, PowerTelemetry, decode_control_request, decode_power,
+    encode_control_request, encode_power,
+};
+use pdcan_types::{CarrierPolicy, PowerReading, PowerSource, RequestId, RequesterId};
+
+#[entry]
+fn main() -> ! {
+    loop {
+        let power = black_box(PowerTelemetry {
+            node: 7,
+            reading: PowerReading {
+                source: PowerSource::CarrierInput,
+                sequence: 42,
+                voltage_mv: 24000,
+                current_ma: -1000,
+                power_mw: -24000,
+            },
+        });
+        let policy = black_box(ControlRequest {
+            node: 7,
+            requester: RequesterId::PDCAN_DEFAULT,
+            request_id: RequestId(42),
+            command: ControlCommand::SetCarrierPolicy(CarrierPolicy::SW3538_SAFE_DISABLED),
+        });
+        if let Ok(frame) = black_box(encode_power(power)) {
+            let _ = black_box(decode_power(
+                black_box(frame.id()),
+                black_box(frame.payload()),
+            ));
+        }
+        if let Ok(frame) = black_box(encode_control_request(policy)) {
+            let _ = black_box(decode_control_request(
+                black_box(frame.id()),
+                black_box(frame.payload()),
+            ));
+        }
+    }
+}
