diff --git a/firmware/crates/pdcan-protocol/benches/codec.rs b/firmware/crates/pdcan-protocol/benches/codec.rs
new file mode 100644
index 0000000..3714de7
--- /dev/null
+++ b/firmware/crates/pdcan-protocol/benches/codec.rs
@@ -0,0 +1,162 @@
+//! Full public-codec benchmark; `PDCAN_CORPUS` emits an exact differential corpus.
+#![allow(clippy::cast_possible_truncation, clippy::cast_possible_wrap)]
+use std::{hint::black_box, time::Instant};
+
+use pdcan_protocol::{
+    ControlCommand, ControlRequest, ExtendedId, PowerTelemetry, decode_control_request,
+    decode_power, encode_control_request, encode_power,
+};
+use pdcan_types::{CarrierPolicy, PdLimits, PowerReading, PowerSource, RequestId, RequesterId};
+
+fn inputs(seed: u32) -> (PowerTelemetry, ControlRequest) {
+    let value = seed.wrapping_mul(0x9e37_79b9);
+    (
+        PowerTelemetry {
+            node: (seed % 254 + 1) as u8,
+            reading: PowerReading {
+                source: if seed & 1 == 0 {
+                    PowerSource::CarrierInput
+                } else {
+                    PowerSource::BackplaneInput
+                },
+                sequence: value as u16,
+                voltage_mv: value,
+                current_ma: value as i32,
+                power_mw: value.rotate_left(13) as i32,
+            },
+        },
+        ControlRequest {
+            node: (seed % 254 + 1) as u8,
+            requester: RequesterId::new(1).unwrap(),
+            request_id: RequestId(u64::from(value) << 32 | u64::from(seed)),
+            command: ControlCommand::SetCarrierPolicy(CarrierPolicy {
+                enabled: seed & 1 != 0,
+                pd_limits: (seed & 2 != 0).then_some(PdLimits {
+                    max_voltage_mv: value,
+                    max_current_ma: value.rotate_left(11),
+                    max_power_mw: value.rotate_left(23),
+                }),
+            }),
+        },
+    )
+}
+
+fn corpus() {
+    for seed in 0..4096 {
+        let (power, policy) = inputs(seed);
+        let p = encode_power(power).unwrap();
+        let c = encode_control_request(policy).unwrap();
+        assert_eq!(decode_power(p.id(), p.payload()), Ok(power));
+        assert_eq!(decode_control_request(c.id(), c.payload()), Ok(policy));
+        println!("{p:?} {:?}", decode_power(p.id(), p.payload()));
+        println!("{c:?} {:?}", decode_control_request(c.id(), c.payload()));
+        if seed < 4 {
+            for frame in [&p, &c] {
+                for offset in 0..frame.payload().len() {
+                    for value in 0..=255 {
+                        let mut bytes = frame.payload().to_vec();
+                        bytes[offset] = value;
+                        println!(
+                            "{:?} {:?}",
+                            decode_power(frame.id(), &bytes),
+                            decode_control_request(frame.id(), &bytes)
+                        );
+                    }
+                }
+                for len in 0..=80 {
+                    let mut bytes = frame.payload().to_vec();
+                    bytes.resize(len, 0);
+                    println!(
+                        "{:?} {:?}",
+                        decode_power(frame.id(), &bytes),
+                        decode_control_request(frame.id(), &bytes)
+                    );
+                }
+                for bit in 0..29 {
+                    let id = ExtendedId::new(frame.id().get() ^ (1 << bit)).unwrap();
+                    println!(
+                        "{:?} {:?}",
+                        decode_power(id, frame.payload()),
+                        decode_control_request(id, frame.payload())
+                    );
+                }
+            }
+        }
+        // Deterministic arbitrary payloads and identifiers, including malformed headers.
+        let mut state = seed.wrapping_add(1);
+        let bytes: [u8; 24] = std::array::from_fn(|_| {
+            state ^= state << 13;
+            state ^= state >> 17;
+            state ^= state << 5;
+            state as u8
+        });
+        let id = ExtendedId::new(state & 0x1fff_ffff).unwrap();
+        println!(
+            "{:?} {:?}",
+            decode_power(id, &bytes[..16]),
+            decode_control_request(id, &bytes)
+        );
+    }
+}
+
+fn measure<T>(name: &str, mut operation: impl FnMut(usize) -> T) {
+    const ITERATIONS: usize = 100_000;
+    for i in 0..ITERATIONS {
+        black_box(operation(i));
+    }
+    let mut samples = Vec::new();
+    for _ in 0..21 {
+        let start = Instant::now();
+        for i in 0..ITERATIONS {
+            black_box(operation(i));
+        }
+        samples.push(
+            start.elapsed().as_secs_f64() * 1e9 / f64::from(u32::try_from(ITERATIONS).unwrap()),
+        );
+    }
+    samples.sort_by(f64::total_cmp);
+    println!(
+        "{name},{:.3},{:.3},{:.3}",
+        samples[10], samples[0], samples[20]
+    );
+}
+
+fn main() {
+    if std::env::var_os("PDCAN_CORPUS").is_some() {
+        return corpus();
+    }
+    let inputs: Vec<_> = (0..256).map(inputs).collect();
+    let powers: Vec<_> = inputs
+        .iter()
+        .map(|(p, _)| encode_power(*p).unwrap())
+        .collect();
+    let policies: Vec<_> = inputs
+        .iter()
+        .map(|(_, c)| encode_control_request(*c).unwrap())
+        .collect();
+    let mut bad_power = powers[0].payload().to_vec();
+    bad_power[3] = 1;
+    let mut bad_policy = policies[0].payload().to_vec();
+    bad_policy[10] = 1;
+    println!("operation,median_ns,min_ns,max_ns");
+    measure("encode_power", |i| {
+        encode_power(black_box(inputs[i & 255].0))
+    });
+    measure("decode_power", |i| {
+        let f = &powers[i & 255];
+        decode_power(black_box(f.id()), black_box(f.payload()))
+    });
+    measure("encode_policy", |i| {
+        encode_control_request(black_box(inputs[i & 255].1))
+    });
+    measure("decode_policy", |i| {
+        let f = &policies[i & 255];
+        decode_control_request(black_box(f.id()), black_box(f.payload()))
+    });
+    measure("reject_power_reserved", |_| {
+        decode_power(black_box(powers[0].id()), black_box(&bad_power))
+    });
+    measure("reject_policy_reserved", |_| {
+        decode_control_request(black_box(policies[0].id()), black_box(&bad_policy))
+    });
+}
