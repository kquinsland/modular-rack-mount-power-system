index 0000000..d3c9bbc
--- /dev/null
+++ b/firmware/crates/pdcan-protocol/tests/codec_vectors.rs
@@ -0,0 +1,97 @@
+use pdcan_protocol::{
+    CodecError, ControlCommand, ControlRequest, PayloadError, PowerTelemetry,
+    decode_control_request, decode_power, encode_control_request, encode_power,
+};
+use pdcan_types::{CarrierPolicy, PdLimits, PowerReading, PowerSource, RequestId, RequesterId};
+
+#[test]
+fn power_matches_independent_little_endian_vector() {
+    let input = PowerTelemetry {
+        node: 7,
+        reading: PowerReading {
+            source: PowerSource::CarrierInput,
+            sequence: 0x1234,
+            voltage_mv: 0x1234_5678,
+            current_ma: -2,
+            power_mw: i32::MIN,
+        },
+    };
+    let frame = encode_power(input).unwrap();
+    let bytes = [
+        0x34, 0x12, 2, 0, 0x78, 0x56, 0x34, 0x12, 0xfe, 0xff, 0xff, 0xff, 0, 0, 0, 0x80,
+    ];
+    assert_eq!(frame.payload(), bytes);
+    assert_eq!(decode_power(frame.id(), &bytes), Ok(input));
+    for source in 0..=255 {
+        let mut invalid = bytes;
+        invalid[2] = source;
+        if source != 1 && source != 2 {
+            assert_eq!(
+                decode_power(frame.id(), &invalid),
+                Err(CodecError::Payload(PayloadError::InvalidValue {
+                    offset: 2,
+                    value: source
+                }))
+            );
+        }
+    }
+}
+
+#[test]
+fn policy_matches_vector_and_rejects_noncanonical_encodings() {
+    let input = ControlRequest {
+        node: 7,
+        requester: RequesterId::PDCAN_DEFAULT,
+        request_id: RequestId(0x0807_0605_0403_0201),
+        command: ControlCommand::SetCarrierPolicy(CarrierPolicy {
+            enabled: true,
+            pd_limits: Some(PdLimits {
+                max_voltage_mv: 0x1234_5678,
+                max_current_ma: 0x90ab_cdef,
+                max_power_mw: u32::MAX,
+            }),
+        }),
+    };
+    let frame = encode_control_request(input).unwrap();
+    let bytes = [
+        1, 2, 3, 4, 5, 6, 7, 8, 1, 1, 0, 0, 0x78, 0x56, 0x34, 0x12, 0xef, 0xcd, 0xab, 0x90, 0xff,
+        0xff, 0xff, 0xff,
+    ];
+    assert_eq!(frame.payload(), bytes);
+    assert_eq!(decode_control_request(frame.id(), &bytes), Ok(input));
+    for offset in [8, 9] {
+        for value in 2..=255 {
+            let mut invalid = bytes;
+            invalid[offset] = value;
+            assert!(decode_control_request(frame.id(), &invalid).is_err());
+        }
+    }
+    for offset in [10, 11] {
+        for value in 1..=255 {
+            let mut invalid = bytes;
+            invalid[offset] = value;
+            assert!(decode_control_request(frame.id(), &invalid).is_err());
+        }
+    }
+    let mut absent = bytes;
+    absent[9] = 0;
+    assert!(decode_control_request(frame.id(), &absent).is_err());
+    absent[12..].fill(0);
+    let decoded = decode_control_request(frame.id(), &absent).unwrap();
+    assert_eq!(
+        decoded.command,
+        ControlCommand::SetCarrierPolicy(CarrierPolicy {
+            enabled: true,
+            pd_limits: None
+        })
+    );
+    assert_eq!(encode_control_request(decoded).unwrap().payload(), absent);
+    for len in 0..=80 {
+        if len == 24 {
+            continue;
+        }
+        let mut malformed = bytes.to_vec();
+        malformed.resize(len, 0);
+        assert!(decode_control_request(frame.id(), &malformed).is_err());
+    }
+}
