new file mode 100644
index 0000000..e17bcc5
--- /dev/null
+++ b/firmware/crates/pdcan-protocol/src/deku_codec.rs
@@ -0,0 +1,80 @@
+//! Opt-in experiment: byte-aligned layouts without std, alloc, or bitvec.
+//! Callers retain all semantic checks and validate lengths before decoding.
+
+use deku::prelude::*;
+use pdcan_types::{CarrierPolicy, PdLimits, PowerReading, PowerSource};
+
+#[derive(DekuRead, DekuWrite)]
+#[deku(endian = "little")]
+struct PolicyBody {
+    enabled: u8,
+    has_limits: u8,
+    reserved: [u8; 2],
+    max_voltage_mv: u32,
+    max_current_ma: u32,
+    max_power_mw: u32,
+}
+
+pub(super) fn encode_policy(policy: CarrierPolicy, output: &mut [u8]) {
+    let limits = policy.pd_limits.unwrap_or(PdLimits {
+        max_voltage_mv: 0,
+        max_current_ma: 0,
+        max_power_mw: 0,
+    });
+    PolicyBody {
+        enabled: u8::from(policy.enabled),
+        has_limits: u8::from(policy.pd_limits.is_some()),
+        reserved: [0; 2],
+        max_voltage_mv: limits.max_voltage_mv,
+        max_current_ma: limits.max_current_ma,
+        max_power_mw: limits.max_power_mw,
+    }
+    .to_slice(output)
+    .expect("fixed policy layout fits 16-byte output");
+}
+
+pub(super) fn decode_policy_limits(input: &[u8]) -> PdLimits {
+    let (_, body) = PolicyBody::from_bytes((input, 0))
+        .expect("validated 16-byte policy body contains only raw integers");
+    PdLimits {
+        max_voltage_mv: body.max_voltage_mv,
+        max_current_ma: body.max_current_ma,
+        max_power_mw: body.max_power_mw,
+    }
+}
+
+#[derive(DekuRead, DekuWrite)]
+#[deku(endian = "little")]
+struct PowerBody {
+    sequence: u16,
+    source: u8,
+    reserved: u8,
+    voltage_mv: u32,
+    current_ma: i32,
+    power_mw: i32,
+}
+
+pub(super) fn encode_power(reading: PowerReading, output: &mut [u8; 16]) {
+    PowerBody {
+        sequence: reading.sequence,
+        source: reading.source as u8,
+        reserved: 0,
+        voltage_mv: reading.voltage_mv,
+        current_ma: reading.current_ma,
+        power_mw: reading.power_mw,
+    }
+    .to_slice(output)
+    .expect("fixed power layout fits 16-byte output");
+}
+
+pub(super) fn decode_power(input: &[u8], source: PowerSource) -> PowerReading {
+    let (_, body) = PowerBody::from_bytes((input, 0))
+        .expect("validated 16-byte power body contains only raw integers");
+    PowerReading {
+        source,
+        sequence: body.sequence,
+        voltage_mv: body.voltage_mv,
+        current_ma: body.current_ma,
+        power_mw: body.power_mw,
+    }
+}
